{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/scadenze",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/laboratorio",
      "destination": "/laboratorio.html"
    },
    {
      "source": "/caf",
      "destination": "/index.html"
    },
    {
      "source": "/ottico",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
